# Copy to .env. Never commit actual credentials.
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_MS=45000
LLM_MAX_OUTPUT_TOKENS=512
LLM_REASONING_EFFORT=none
RUN_TIMEOUT_MS=240000
MAX_AGENT_STEPS=18
MAX_TOOL_CALLS=48
MAX_WORKERS=6
CONTROL_PORT=4310
SWARM_PROFILE=classic
EXPANDED_MAX_WORKERS=10
TARGET_RUNTIME=local
TENKI_API_KEY=
# Registry package downloaded on first use; generated code has no network.
WASMER_PYTHON_PACKAGE=python/python@=3.13.18

{
  "name": "flash0ver",
  "version": "1.0.0",
  "description": "Runtime security for autonomous AI agent swarms.",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Muzzy5150/Flash0ver.git"
  },
  "homepage": "https://github.com/Muzzy5150/Flash0ver#readme",
  "bugs": {
    "url": "https://github.com/Muzzy5150/Flash0ver/issues"
  },
  "keywords": [
    "ai-security",
    "agentic-ai",
    "runtime-security",
    "multi-agent-systems",
    "wasmer"
  ],
  "scripts": {
    "dev": "concurrently -k -n control,web 'npm:worker' 'next dev --hostname 127.0.0.1'",
    "worker": "tsx --env-file-if-exists=.env worker/control-plane.ts",
    "build": "next build",
    "start": "concurrently -k -n control,web 'npm:worker' 'next start --hostname 127.0.0.1'",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run test:wasmer && npm run build",
    "preflight": "tsx --env-file-if-exists=.env scripts/preflight.ts",
    "test:wasmer": "tsx scripts/verify-wasmer.ts",
    "demo:verify": "tsx --env-file-if-exists=.env scripts/verify-live.ts",
    "demo:rehearse": "tsx --env-file-if-exists=.env scripts/rehearsal.ts",
    "demo:reliability": "tsx --env-file-if-exists=.env scripts/verify-reliability.ts",
    "demo:latency": "tsx scripts/analyze-latency.ts",
    "test:tenki-live": "tsx --env-file-if-exists=.env scripts/verify-tenki-live.ts"
  },
  "engines": {
    "node": ">=24.10.0"
  },
  "dependencies": {
    "@tenkicloud/sandbox": "^1.0.6",
    "@wasmer/sdk": "^0.11.0",
    "next": "^16.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
